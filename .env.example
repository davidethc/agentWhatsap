# Copia este archivo como .env y ajusta los valores:
#   cp .env.example .env

# Zona horaria (lista: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
GENERIC_TIMEZONE=America/Guayaquil

# Para uso local deja estos valores.
N8N_HOST=localhost
N8N_PROTOCOL=http

# URL pública donde WhatsApp enviará los mensajes (webhooks).
# En local: http://localhost:5678/
# Con un túnel (ngrok / cloudflared): https://TU-SUBDOMINIO.ngrok-free.app/
WEBHOOK_URL=http://localhost:5678/
