# Plantilla de configuración, sin secretos.
# Crea tu .env con secretos nuevos ejecutando:  scripts/init-env.sh
# Nunca subas .env a Git.

# --- Versión -----------------------------------------------------------------
# Versión exacta de n8n. n8n, el worker y los runners usan la misma.
N8N_VERSION=2.41.5

# --- Dirección pública -------------------------------------------------------
# Con ngrok: N8N_HOST=tu-dominio.ngrok-free.dev, N8N_PROTOCOL=https y
# WEBHOOK_URL=https://tu-dominio.ngrok-free.dev/ (con "/" al final).
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/

# Zona horaria (lista: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
GENERIC_TIMEZONE=America/Guayaquil

# --- Secretos (los genera scripts/init-env.sh) -------------------------------
# Clave de cifrado de las credenciales de n8n. Una vez creada, NO la cambies:
# sin la misma clave, n8n no puede abrir las credenciales guardadas.
N8N_ENCRYPTION_KEY=

# PostgreSQL y Redis: solo accesibles dentro de la red Docker del proyecto.
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Token compartido entre n8n, el worker y sus runners externos.
N8N_RUNNERS_AUTH_TOKEN=

# Eli Panel: conexión a la base (Session pooler) solo para scripts/backup-crm.sh. Secreta: el valor va en .env, nunca aquí.
CRM_DB_URL=
