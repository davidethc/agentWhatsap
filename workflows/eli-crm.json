{
  "id": "EliCrmSubwf00001",
  "name": "Eli → CRM",
  "description": "Sub-workflow de Eli hacia el Eli Panel (CRM). Recibe un evento {tipo, telefono, ...} (docs/crm/plan.md sección 5), lo envía por POST a la Edge Function eli-evento con el encabezado x-eli-secreto (credencial «Eli CRM secreto», tipo Header Auth), con timeout de 5 s y 2 reintentos. Si falla, guarda el evento en la lista Redis v4:crm:errores (LPUSH, tope de 200) y termina SIN error: Eli nunca depende del CRM. Cambiar la URL del nodo «Enviar a eli-evento» al pasar a la nube de Supabase.",
  "nodes": [
    {
      "parameters": {
        "inputSource": "passthrough"
      },
      "id": "c1a10001-0000-4000-8000-000000000001",
      "name": "Entrada interna",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:55321/functions/v1/eli-evento",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 5000
        }
      },
      "id": "c1a10001-0000-4000-8000-000000000002",
      "name": "Enviar a eli-evento",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "onError": "continueErrorOutput",
      "credentials": {
        "httpHeaderAuth": {
          "id": "EliCrmSecret0001",
          "name": "Eli CRM secreto"
        }
      }
    },
    {
      "parameters": {},
      "id": "c1a10001-0000-4000-8000-000000000003",
      "name": "Guardado",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        480,
        -80
      ]
    },
    {
      "parameters": {
        "jsCode": "// Falló el envío al CRM: arma la entrada que se guarda en Redis (v4:crm:errores).\n// No se guarda el secreto (no está en la entrada) y el error se recorta.\nconst evento = $('Entrada interna').first().json;\nconst err = $json.error ?? $json;\nconst detalle = (typeof err === 'string' ? err : (err.message ?? JSON.stringify(err))).slice(0, 500);\nreturn [{ json: { entrada: JSON.stringify({ en: new Date().toISOString(), error: detalle, evento }) } }];"
      },
      "id": "c1a10001-0000-4000-8000-000000000004",
      "name": "Armar error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        100
      ]
    },
    {
      "parameters": {
        "operation": "push",
        "list": "v4:crm:errores",
        "messageData": "={{ $json.entrada }}",
        "tail": false
      },
      "id": "c1a10001-0000-4000-8000-000000000005",
      "name": "Guardar error (LPUSH)",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [
        720,
        100
      ],
      "onError": "continueRegularOutput",
      "credentials": {
        "redis": {
          "id": "redisLocalCred01",
          "name": "Redis local"
        }
      }
    },
    {
      "parameters": {
        "operation": "llen",
        "list": "v4:crm:errores"
      },
      "id": "c1a10001-0000-4000-8000-000000000006",
      "name": "Largo de la lista",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [
        960,
        100
      ],
      "onError": "continueRegularOutput",
      "credentials": {
        "redis": {
          "id": "redisLocalCred01",
          "name": "Redis local"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1a10001-0000-4000-8000-0000000000a1",
              "leftValue": "={{ $json[\"v4:crm:errores\"] }}",
              "rightValue": 200,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "c1a10001-0000-4000-8000-000000000007",
      "name": "¿Más de 200?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1200,
        100
      ]
    },
    {
      "parameters": {
        "operation": "pop",
        "list": "v4:crm:errores",
        "tail": true,
        "propertyName": "descartado"
      },
      "id": "c1a10001-0000-4000-8000-000000000008",
      "name": "Recortar a 200 (RPOP)",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [
        1440,
        20
      ],
      "onError": "continueRegularOutput",
      "credentials": {
        "redis": {
          "id": "redisLocalCred01",
          "name": "Redis local"
        }
      }
    }
  ],
  "connections": {
    "Entrada interna": {
      "main": [
        [
          {
            "node": "Enviar a eli-evento",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Enviar a eli-evento": {
      "main": [
        [
          {
            "node": "Guardado",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Armar error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Armar error": {
      "main": [
        [
          {
            "node": "Guardar error (LPUSH)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Guardar error (LPUSH)": {
      "main": [
        [
          {
            "node": "Largo de la lista",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Largo de la lista": {
      "main": [
        [
          {
            "node": "¿Más de 200?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "¿Más de 200?": {
      "main": [
        [
          {
            "node": "Recortar a 200 (RPOP)",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
