# Plantilla sin secretos. Copia como .env (PowerShell: Copy-Item .env.example .env).

# Zona horaria (lista: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
GENERIC_TIMEZONE=America/Guayaquil

# Para abrir n8n en esta computadora, deja estos valores.
N8N_HOST=localhost
N8N_PROTOCOL=http

# URL pública HTTPS que Kapso usará para llamar al webhook.
# Déjala local mientras configuras n8n; cámbiala por la URL del túnel antes de probar WhatsApp.
WEBHOOK_URL=http://localhost:5678/

# Versión exacta de n8n (main, worker y runners usan la misma).
N8N_VERSION=2.41.5

# Clave de cifrado de credenciales. NO la cambies en una instalación existente.
N8N_ENCRYPTION_KEY=

# PostgreSQL y Redis (solo accesibles dentro de la red Docker).
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Token compartido entre n8n/worker y sus runners externos.
N8N_RUNNERS_AUTH_TOKEN=
